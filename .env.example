# Leave blank to use the bundled LOCAL DEMO at /api/v1 (manual judging).
# For AWS, set the FULL API prefix, including the stage/path if applicable.
# The frontend does not append /api or /api/v1 to this value.
# AWS handoff: us-east-1, stage dev; see .env.aws.example for supplied URLs.
VITE_API_BASE_URL=

# Optional API Gateway WebSocket endpoint. HTTP polling remains a fallback.
# Supplied endpoint: wss://n6x63b8svl.execute-api.us-east-1.amazonaws.com/dev
# Keep blank until the backend implements connection tickets and game binding.
# A successful wscat connection alone does not confirm event delivery. See docs/AWS.md.
VITE_WS_URL=

# Live administrator login (Cognito/OIDC public client, authorization code + PKCE).
# Enable code grant, register the exact redirect URI, and do NOT use a client secret.
VITE_ADMIN_AUTH_MODE=oidc
VITE_ADMIN_AUTHORIZE_URL=
VITE_ADMIN_TOKEN_URL=
VITE_ADMIN_CLIENT_ID=
VITE_ADMIN_REDIRECT_URI=http://localhost:5173/admin
VITE_ADMIN_SCOPE=openid email profile
