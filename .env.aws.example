# AWS development configuration supplied by the project owner.
# This template is not loaded automatically, so the local demo stays available.
# After deploying backend/ and connecting API Gateway, copy this file to .env.local
# and restart npm run dev. See docs/AWS.md for integration status.
VITE_API_BASE_URL=https://q4dvfowmm5.execute-api.us-east-1.amazonaws.com/dev

# Enable after connecting the WebSocket routes and DynamoDB stream (backend/REALTIME.md).
VITE_WS_URL=wss://n6x63b8svl.execute-api.us-east-1.amazonaws.com/dev

# Host access code is entered in the host UI, never bundled into VITE_* values.
VITE_ADMIN_AUTH_MODE=token

# Optional alternative: set VITE_ADMIN_AUTH_MODE=oidc and fill these in.
VITE_ADMIN_AUTHORIZE_URL=
VITE_ADMIN_TOKEN_URL=
VITE_ADMIN_CLIENT_ID=
VITE_ADMIN_REDIRECT_URI=http://localhost:5173/admin
VITE_ADMIN_SCOPE=openid email profile
